include LICENSE pyproject.toml run_tests.py
include setup.py flowevent/_core.c flowevent/_core.pyi
include README.md README-TR.md CHANGELOG.md
include flowevent/py.typed
recursive-include tests *.py *.json
recursive-include benchmarks *.py
recursive-include tools *.py
prune benchmarks/results
global-exclude *.py[cod] *.so *.pyd *.dll *.dylib *.gcno *.gcda
